# ===== SaúdeFlow — configuração de ambiente =====
# Copie para .env e ajuste. Nunca commite o .env.

APP_NAME=SaudeFlow
ENV=development
DEBUG=true
DEMO_MODE=true

# Banco de dados.
# Local sem Docker (fallback de desenvolvimento):
DATABASE_URL=sqlite:///./saudeFlow.db
# Docker / produção (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://saude:saude123@db:5432/saudeflow

# Segurança (troque em produção)
SECRET_KEY=troque-esta-chave-em-producao
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — origens separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== Integrações externas =====
CNES_BASE_URL=https://apidadosabertos.saude.gov.br
DATASUS_BASE_URL=https://apidadosabertos.saude.gov.br
IBGE_BASE_URL=https://servicodados.ibge.gov.br/api/v1
VIACEP_BASE_URL=https://viacep.com.br/ws
OSRM_BASE_URL=https://router.project-osrm.org

# Sincronização periódica (cache local, sem consultas externas por usuário)
SYNC_ENABLED=false
SYNC_INTERVAL_MINUTES=360
SYNC_RATE_LIMIT_RPM=60
SYNC_DEFAULT_UF=SP
SYNC_DEFAULT_MUNICIPIO_IBGE=3550308
